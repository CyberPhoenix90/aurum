{
    "name": "aurum-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Monorepo for all Aurum packages",
    "workspaces": [
        "packages/aurum-streams",
        "packages/aurum-remote",
        "packages/aurum-rendering",
        "packages/aurum-html",
        "packages/aurum-compat",
        "packages/aurum-canvas",
        "packages/aurum-components",
        "packages/aurum-server",
        "packages/aurum-vite-plugin",
        "packages/aurum-devtools-extension"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "devtools:build": "npm run build --workspace @aurum/vite-plugin && npm run build --workspace @aurum/devtools-extension",
        "test:install-browser": "playwright install chromium",
        "clean": "node scripts/clean.mjs",
        "package": "node scripts/prepare-pack.mjs && npm pack --workspaces --pack-destination artifacts"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "devDependencies": {
        "typescript": "^5.6.2",
        "vite": "^8.0.0"
    }
}
