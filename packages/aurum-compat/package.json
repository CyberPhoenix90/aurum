{
    "name": "@aurum/compat",
    "version": "0.10.0",
    "description": "Optional React-shaped migration runtime backed by Aurum rendering and streams",
    "type": "module",
    "main": "./prebuilt/esnext/index.js",
    "types": "./prebuilt/esnext/index.d.ts",
    "exports": {
        ".": {
            "types": "./prebuilt/esnext/index.d.ts",
            "import": "./prebuilt/esnext/index.js"
        },
        "./client": {
            "types": "./prebuilt/esnext/client.d.ts",
            "import": "./prebuilt/esnext/client.js"
        },
        "./test-utils": {
            "types": "./prebuilt/esnext/test-utils.d.ts",
            "import": "./prebuilt/esnext/test-utils.js"
        },
        "./jsx-runtime": {
            "types": "./prebuilt/esnext/jsx-runtime.d.ts",
            "import": "./prebuilt/esnext/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./prebuilt/esnext/jsx-dev-runtime.d.ts",
            "import": "./prebuilt/esnext/jsx-dev-runtime.js"
        }
    },
    "files": ["prebuilt", "README.md", "LICENSE"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "tsc -p tsconfig.test.json && vitest run",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@aurum/html": "^0.10.0",
        "@aurum/rendering": "^0.10.0",
        "@aurum/streams": "^0.10.0"
    },
    "devDependencies": {
        "@vitest/browser": "^4.0.16",
        "@vitest/browser-playwright": "^4.0.16",
        "vitest": "^4.0.16"
    },
    "license": "MIT"
}
