{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist_test",
        "declaration": false,
        "declarationMap": false,
        "baseUrl": ".",
        "paths": {
            "@aurumjs/compat": ["src/index.ts"],
            "@aurumjs/compat/jsx-runtime": ["src/jsx-runtime.ts"],
            "@aurumjs/compat/jsx-dev-runtime": ["src/jsx-dev-runtime.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
