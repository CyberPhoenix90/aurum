{
    "name": "@aurum/vite-plugin",
    "version": "0.1.0",
    "description": "Vite build policy for Aurum developer tooling metadata",
    "type": "module",
    "main": "./prebuilt/esnext/index.js",
    "types": "./prebuilt/esnext/index.d.ts",
    "exports": {
        ".": {
            "types": "./prebuilt/esnext/index.d.ts",
            "import": "./prebuilt/esnext/index.js"
        },
        "./client": {
            "types": "./client.d.ts"
        }
    },
    "files": ["prebuilt", "client.d.ts", "README.md", "LICENSE"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "tsc -p tsconfig.test.json && vitest run --config vitest.config.ts",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "devDependencies": {
        "vite": "^8.0.0",
        "vitest": "^4.0.16"
    },
    "license": "MIT"
}
