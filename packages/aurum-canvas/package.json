{
    "name": "@aurum/canvas",
    "version": "0.0.54",
    "description": "Aurum style scene graph management for rendering in canvas",
    "type": "module",
    "main": "./prebuilt/esnext/aurum-canvas.js",
    "types": "./prebuilt/esnext/aurum-canvas.d.ts",
    "exports": {
        ".": {
            "types": "./prebuilt/esnext/aurum-canvas.d.ts",
            "import": "./prebuilt/esnext/aurum-canvas.js"
        },
        "./core": {
            "types": "./prebuilt/esnext/core.d.ts",
            "import": "./prebuilt/esnext/core.js"
        }
    },
    "files": ["prebuilt", "README.md", "LICENSE"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "tsc -p tsconfig.test.json && vitest run",
        "benchmark": "tsc -p tsconfig.bench.json && node dist_bench/bench/run.js",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@aurum/html": "^0.1.0",
        "@aurum/rendering": "^0.1.0"
    },
    "devDependencies": {
        "@vitest/browser": "^4.0.16",
        "@vitest/browser-playwright": "^4.0.16",
        "vitest": "^4.0.16"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CyberPhoenix90/aurum.git",
        "directory": "packages/aurum-canvas"
    },
    "keywords": ["aurum", "scenegraph", "canvas", "rendering"],
    "author": "Joao Santos (CyberPhoenix)",
    "license": "MIT"
}
