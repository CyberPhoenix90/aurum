{
    "name": "aurumjs",
    "version": "0.9.54",
    "main": "prebuilt/esnext/aurumjs.js",
    "typings": "prebuilt/esnext/aurumjs.d.ts",
    "exports": {
        "import": "./prebuilt/esnext/aurumjs.js",
        "require": "./prebuilt/cjs/aurumjs.js"
    },
    "description": "Stream based declarative DOM rendering library for javascript",
    "compiler": "typescript",
    "homepage": "https://cyberphoenix90.github.io/aurum-website/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CyberPhoenix90/aurum"
    },
    "keywords": [
        "web-components",
        "webcomponents",
        "DOM",
        "stream",
        "rendering"
    ],
    "author": "Joao Santos (CyberPhoenix)",
    "license": "MIT",
    "scripts": {
        "test": "vitest"
    },
    "devDependencies": {
        "@types/sinon": "^9.0.4",
        "sinon": "^9.0.3",
        "vitest": "^4.0.16",
        "@vitest/browser": "^4.0.16",
        "@vitest/browser-playwright": "^4.0.16"
    },
    "defaultBuildSettings": {
        "assembly": "library",
        "includes": [
            "src/**/*.ts",
            "src/**/*.tsx",
            "test/**/*.ts",
            "test/**/*.tsx"
        ],
        "jsxFragmentFactory": "Aurum.fragment",
        "jsxFactory": "Aurum.factory",
        "jsx": "react"
    },
    "builds": [
        {
            "outdir": "dist_test",
            "name": "test",
            "platform": "isomorphic"
        },
        {
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx"
            ],
            "outdir": "prebuilt/esnext",
            "name": "esnext",
            "platform": "isomorphic"
        },
        {
            "includes": [
                "src/**/*.ts",
                "src/**/*.tsx"
            ],
            "outdir": "prebuilt/cjs",
            "module": "commonjs",
            "name": "cjs",
            "moduleResolution": "node",
            "platform": "node"
        }
    ]
}