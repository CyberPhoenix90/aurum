{
    "name": "aurumjs",
    "version": "0.9.55",
    "description": "Stream based declarative DOM rendering library for JavaScript",
    "type": "module",
    "main": "./prebuilt/cjs/aurumjs.js",
    "module": "./prebuilt/esnext/aurumjs.js",
    "types": "./prebuilt/esnext/aurumjs.d.ts",
    "exports": {
        ".": {
            "types": "./prebuilt/esnext/aurumjs.d.ts",
            "import": "./prebuilt/esnext/aurumjs.js",
            "require": "./prebuilt/cjs/aurumjs.js"
        },
        "./streams": {
            "types": "./prebuilt/esnext/streams.d.ts",
            "import": "./prebuilt/esnext/streams.js",
            "require": "./prebuilt/cjs/streams.js"
        },
        "./rendering": {
            "types": "./prebuilt/esnext/rendering.d.ts",
            "import": "./prebuilt/esnext/rendering.js",
            "require": "./prebuilt/cjs/rendering.js"
        },
        "./html": {
            "types": "./prebuilt/esnext/html.d.ts",
            "import": "./prebuilt/esnext/html.js",
            "require": "./prebuilt/cjs/html.js"
        }
    },
    "files": [
        "prebuilt",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "npm run build:esm && npm run build:cjs",
        "build:esm": "tsc -p tsconfig.build.json",
        "build:cjs": "tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs",
        "build:test": "tsc -p tsconfig.test.json",
        "test": "npm run build:test && vitest run",
        "prepack": "npm run build"
    },
    "homepage": "https://cyberphoenix90.github.io/aurum-website/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CyberPhoenix90/aurum.git",
        "directory": "packages/aurum"
    },
    "keywords": [
        "DOM",
        "stream",
        "rendering"
    ],
    "author": "Joao Santos (CyberPhoenix)",
    "license": "MIT",
    "devDependencies": {
        "@types/sinon": "^9.0.4",
        "@vitest/browser": "^4.0.16",
        "@vitest/browser-playwright": "^4.0.16",
        "sinon": "^9.0.3",
        "vitest": "^4.0.16"
    }
}
